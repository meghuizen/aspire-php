<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Meghuizen.Aspire.Hosting.Php</PackageId>
    <Description>PHP hosting integration for Aspire. Run PHP workers and FrankenPHP web applications as Aspire resources, and publish them as hardened non-root containers.</Description>
    <PackageTags>aspire integration hosting php frankenphp composer opentelemetry</PackageTags>
    <PackageProjectUrl>https://github.com/meghuizen/aspire-php</PackageProjectUrl>
    <RepositoryUrl>https://github.com/meghuizen/aspire-php</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aspire.Hosting.PHP.Tests" />
  </ItemGroup>

</Project>
